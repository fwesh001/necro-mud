{
  "name": "necro-mud",
  "version": "0.1.0",
  "private": true,
  "description": "A multiplayer ANSI-art terminal dungeon accessible via retro CRT web interface and WebSockets — your GitHub repository is your dungeon",
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "build:shared": "pnpm --filter @necro-mud/shared build",
    "build:server": "pnpm --filter @necro-mud/server build",
    "build:client": "pnpm --filter @necro-mud/client build",
    "build": "pnpm run build:shared && pnpm run build:server && pnpm run build:client",
    "dev:server": "pnpm --filter @necro-mud/server dev",
    "dev:client": "pnpm --filter @necro-mud/client dev",
    "dev": "concurrently --names SERVER,CLIENT --prefix-colors blue,green \"pnpm run dev:server\" \"pnpm run dev:client\"",
    "typecheck": "tsc -b tsconfig.base.json && pnpm --filter @necro-mud/client typecheck",
    "start:server": "pnpm --filter @necro-mud/server start",
    "start:client": "pnpm --filter @necro-mud/client start",
    "test:smoke": "node server/test-smoke.mjs",
    "play": "node server/cli.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fwesh001/necro-mud.git"
  },
  "keywords": [
    "mud",
    "bbs",
    "ansi",
    "terminal",
    "dungeon",
    "multiplayer",
    "retro",
    "crt",
    "hackathon",
    "kiroween"
  ]
}

